# Akunga Commerce — browser environment (Vite). Copy to .env.local.
# Only PUBLIC values belong here: everything prefixed VITE_ is shipped to the browser.
# Never put a service-role key, provider secret or API token in this file.

# Supabase project URL and anon (publishable) key. Leave both empty to run the
# in-browser demo workspace with fictional data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: force "demo" even when Supabase is configured.
# VITE_DATA_MODE=demo

# ── Tests only (not used by the app) ──
# Postgres URL for the database integration tests (local Supabase: `npx supabase status`).
# SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:58322/postgres

# ── Server-side secrets ──
# Edge Function secrets are set with `supabase secrets set NAME=value`, never here.
# See supabase/functions/README.md for the list.
